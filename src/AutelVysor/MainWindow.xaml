<Window x:Class="AutelVysor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autel Vysor" Width="1380" Height="860" MinWidth="980" MinHeight="640"
        Background="#0B1120" Foreground="#F1F5F9"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F8FAFC"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <ContentPresenter Margin="8,4,30,4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                  <TextBlock Text="▼" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="10"/>
                </Grid>
              </ToggleButton>
              <Popup x:Name="Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False">
                <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer CanContentScroll="True" MaxHeight="260">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border x:Name="TopBar" Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,13">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock FontSize="24" FontWeight="Bold" Text="Autel Vysor"/>
          <TextBlock Margin="0,3,0,0" Foreground="#94A3B8" Text="Android 4.4+ · embedded mirror · USB / Wi-Fi · multi-device"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <CheckBox x:Name="AutoReconnectBox" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,7" Content="Auto reconnect Wi-Fi"/>
          <Button x:Name="SidebarToggleButton" Click="SidebarToggle_Click" Content="Hide sidebar" Background="#475569"/>
          <Button Click="Fullscreen_Click" Content="Full screen" Background="#475569"/>
          <Button Click="Diagnostics_Click" Content="Copy diagnostics" Background="#475569"/>
          <Button Click="Refresh_Click" Content="Refresh devices"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="390"/>
        <ColumnDefinition x:Name="SidebarSplitterColumn" Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarPanel" Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Connected devices"/>
            <TextBlock Margin="0,4,0,10" Foreground="#64748B" Text="Select one or more devices. Double-click to open a mirror tab. Android 4.4 tabs also accept dropped APK/files." TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Click="Mirror_Click" Content="Open selected"/>
              <Button Click="OpenAll_Click" Content="Open all" Background="#334155"/>
              <Button Click="CloseSession_Click" Content="Close current tab" Background="#334155"/>
              <Button Click="DeviceDebug_Click" Content="Device debug" Background="#475569"/>
            </WrapPanel>
          </StackPanel>

          <ListBox Grid.Row="1" x:Name="DeviceList"
                   Margin="0,10,0,8"
                   SelectionMode="Extended"
                   MouseDoubleClick="DeviceList_MouseDoubleClick"
                   Background="#111827"
                   Foreground="White"
                   BorderBrush="#334155"
                   FontSize="13"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,8"
                        Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Background}"
                        CornerRadius="6">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#86EFAC" FontSize="11"/>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding Meta}" Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Margin="0,2,0,0" Text="{Binding Serial}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer Grid.Row="2"
                        Margin="0,4,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False">
            <StackPanel>
            <Expander Header="Wi-Fi debugging">
              <StackPanel Margin="0,8,0,0">
                <TextBox x:Name="AddressBox" Text="192.168.1.10:5555" ToolTip="host:port"/>
                <TextBox x:Name="PairCodeBox" ToolTip="Android 11+ six-digit pairing code"/>
                <WrapPanel>
                  <Button Click="Pair_Click" Content="Pair"/>
                  <Button Click="Connect_Click" Content="Connect"/>
                  <Button Click="Disconnect_Click" Content="Disconnect" Background="#475569"/>
                  <Button Click="TcpIp_Click" Content="USB → TCP/IP" Background="#475569"/>
                </WrapPanel>
              </StackPanel>
            </Expander>

            <Expander Header="Mirror settings">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Foreground="#94A3B8" Margin="0,0,0,5" Text="Quality preset"/>
                <ComboBox x:Name="MirrorQualityBox" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,7,7">
                  <ComboBoxItem Content="Smooth · 1280 / 4 Mbps / 30 FPS"/>
                  <ComboBoxItem Content="Standard · 1920 / 8 Mbps / 60 FPS"/>
                  <ComboBoxItem Content="High · 2560 / 12 Mbps / 60 FPS"/>
                </ComboBox>
                <CheckBox x:Name="AudioBox" Margin="0,3,0,7" Content="Enable mirror audio"/>
                <CheckBox x:Name="KeepDeviceAudioBox" IsChecked="True" Margin="0,3,0,4" Content="Keep phone / Bluetooth audio (recommended)"/>
                <TextBlock Margin="22,0,4,7" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"
                           Text="Android 13+: audio is duplicated to PC and device. Android 11/12: device/Bluetooth audio takes priority."/>
                <CheckBox x:Name="ClipboardBox" Margin="0,3,0,7" Content="Synchronize clipboard"/>
                <CheckBox x:Name="ScreenOffBox" IsChecked="True" Margin="0,3,0,7" Content="Turn Android screen off while mirroring (default)"/>
                <CheckBox x:Name="LegacyAccelerationBox" Margin="0,3,0,7" Content="Prefer Android 4.4 accelerated capture when available"/>
                <Button Click="ApplyMirrorSettings_Click" Content="Apply &amp; restart mirrors" Background="#475569"/>
              </StackPanel>
            </Expander>

            <Expander Header="Files / utilities">
              <StackPanel Margin="0,8,0,0">
                <WrapPanel>
                  <Button Click="Screenshot_Click" Content="Screenshot"/>
                  <Button Click="Record_Click" Content="Record MP4"/>
                  <Button Click="Install_Click" Content="Install APK"/>
                  <Button Click="Push_Click" Content="Send file"/>
                </WrapPanel>
                <TextBox x:Name="RemotePathBox" Text="/sdcard/Download/example.txt"/>
                <WrapPanel>
                  <Button Click="Pull_Click" Content="Pull file" Background="#475569"/>
                  <Button Click="OpenFolder_Click" Content="Open videos" Background="#475569"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#1E293B"/>

      <Grid Grid.Column="2" Background="#070B12">
        <TabControl x:Name="SessionTabs" Background="#070B12" BorderThickness="0" Padding="0">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TabPanel Grid.Row="0" IsItemsHost="True" Background="#0F172A" Margin="8,7,8,0"/>
                <Border Grid.Row="1" Background="#070B12" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                  <ContentPresenter ContentSource="SelectedContent"/>
                </Border>
              </Grid>
            </ControlTemplate>
          </TabControl.Template>
        </TabControl>

        <StackPanel x:Name="EmptyWorkspace" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
          <TextBlock FontSize="24" FontWeight="SemiBold" Text="No mirror session open" HorizontalAlignment="Center"/>
          <TextBlock Margin="0,10,0,0" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Select a device on the left and choose Open selected. Android 5.0+ is embedded using scrcpy; Android 4.4 uses the compatibility backend."/>
        </StackPanel>
      </Grid>
    </Grid>

    <Border x:Name="StatusBar" Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,8">
      <DockPanel>
        <TextBlock x:Name="MonitorText" DockPanel.Dock="Right" Foreground="#475569" Text="Monitor: idle"/>
        <TextBlock x:Name="StatusText" Foreground="#94A3B8" Text="Ready" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
