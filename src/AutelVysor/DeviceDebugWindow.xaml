<Window x:Class="AutelVysor.DeviceDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/AutelVysor;component/Assets/AutelVysor.ico"
        Title="Autel Vysor · Device Debug"
        Width="1180" Height="780" MinWidth="980" MinHeight="680"
        Background="#1B1E1C" Foreground="#F1F5F9">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Background" Value="#526F62"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Background" Value="#242826"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="BorderBrush" Value="#404A45"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
      <Setter Property="Padding" Value="7"/>
      <Setter Property="Background" Value="#242826"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#404A45"/>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItemStyle}">
      <Setter Property="Background" Value="#242826"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItemStyle}">
      <Setter Property="Padding" Value="14,8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#202322" BorderBrush="#303633" BorderThickness="0,0,0,1" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="DeviceNameText" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="DeviceMetaText" Margin="0,4,0,0" Foreground="#A2ADA6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="DebugBusyText" Text="Working… please wait" Visibility="Collapsed" Foreground="#A1BDAA" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshPackagesButton" Click="RefreshPackages_Click" Content="Refresh packages" Background="#48534D"/>
          <Button Click="RefreshAppInfo_Click" Content="Refresh selected app"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="DebugTabs" Grid.Row="1" Margin="12" Background="#1B1E1C" BorderBrush="#303633">
      <TabItem Header="App">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Apps" Foreground="#A2ADA6" Margin="0,7,8,0"/>
                <ComboBox x:Name="AppCategoryBox" Width="120" SelectedIndex="0" SelectionChanged="AppFilterChanged">
                  <ComboBoxItem Content="All"/>
                  <ComboBoxItem Content="User"/>
                  <ComboBoxItem Content="System"/>
                </ComboBox>
                <TextBox x:Name="PackageSearchBox" Width="255" Margin="8,0,0,0"
                         TextChanged="AppFilterChanged" ToolTip="Search by application name or package"/>
              </WrapPanel>
              <TextBlock x:Name="SearchMatchText" Text="Search by app name or package" Foreground="#A1BDAA"/>
              <ListBox x:Name="AppSearchResults" MaxHeight="115" Visibility="Collapsed" SelectionChanged="AppSearchResultSelected"
                       Background="#202322" Foreground="#E5E7EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItemStyle}"><Setter Property="Padding" Value="8,6"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="PackageResultsText" Foreground="#A2ADA6" TextWrapping="Wrap"/>
              <TextBlock Foreground="#A2ADA6" Margin="0,0,0,5" Text="Package name"/>
              <ComboBox x:Name="PackageBox"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        StaysOpenOnEdit="True"
                        MinWidth="520" Margin="0,0,0,7"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
              <Button x:Name="InstallApkButton" Click="InstallApk_Click" Content="Install APK" Background="#48534D"/>
              <Button Click="UninstallApp_Click" Content="Uninstall" Background="#76514A"/>
            </StackPanel>
          </Grid>

          <WrapPanel Grid.Row="1" Margin="0,12,0,10">
            <Button Click="ForceStopApp_Click" Content="Stop app" Background="#48534D"/>
            <Button Click="StartApp_Click" Content="Start app"/>
            <Button Click="RestartApp_Click" Content="Restart app" Background="#48534D"/>
            <Button Click="ClearAppData_Click" Content="Clear data" Background="#76514A"/>
            <CheckBox x:Name="KeepDataBox" Margin="8,0,0,7" VerticalAlignment="Center" Content="Keep data when uninstalling"/>
          </WrapPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340"/>
              <ColumnDefinition Width="5"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#202322" BorderBrush="#303633" BorderThickness="1" Padding="14">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="App summary"/>
                <TextBlock x:Name="AppStatusText" TextWrapping="Wrap" Foreground="#A1BDAA" Margin="0,8,0,0"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Version" Foreground="#829088"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText"/>
                  <TextBlock Grid.Row="1" Text="Version code" Foreground="#829088"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionCodeText"/>
                  <TextBlock Grid.Row="2" Text="PID" Foreground="#829088"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PidText"/>
                  <TextBlock Grid.Row="3" Text="Min SDK" Foreground="#829088"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MinSdkText"/>
                  <TextBlock Grid.Row="4" Text="Target SDK" Foreground="#829088"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TargetSdkText"/>
                  <TextBlock Grid.Row="5" Text="First install" Foreground="#829088"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" x:Name="FirstInstallText" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="6" Text="Last update" Foreground="#829088"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LastUpdateText" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="7" Text="Data dir" Foreground="#829088"/>
                  <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DataDirText" TextWrapping="Wrap"/>
                </Grid>
              </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#303633"/>

            <TabControl Grid.Column="2" Margin="10,0,0,0" Background="#202322">
              <TabItem Header="Permissions">
                <TextBox x:Name="PermissionsTextBox"
                         IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"/>
              </TabItem>
              <TabItem Header="Permission manager">
                <Grid Margin="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Runtime permission (pm grant / revoke)" Foreground="#C9D1CC"/>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,9">
                    <TextBox x:Name="PermissionNameBox" Width="290" Text="android.permission.CAMERA"/>
                    <Button Click="GrantPermission_Click" Content="Grant" Margin="8,0,4,0"/>
                    <Button Click="RevokePermission_Click" Content="Revoke" Background="#76514A"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="AppOps (Android enforces support / permissions)" Foreground="#C9D1CC"/>
                  <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <WrapPanel>
                      <TextBox x:Name="AppOpNameBox" Width="140" Text="CAMERA"/>
                      <ComboBox x:Name="AppOpModeBox" Width="120" Margin="8,0,8,0" SelectedIndex="0">
                        <ComboBoxItem Content="allow"/>
                        <ComboBoxItem Content="ignore"/>
                        <ComboBoxItem Content="deny"/>
                        <ComboBoxItem Content="default"/>
                      </ComboBox>
                      <Button Click="SetAppOp_Click" Content="Set AppOp"/>
                      <Button Click="RefreshAppOps_Click" Content="Read AppOps" Background="#48534D"/>
                    </WrapPanel>
                    <TextBox x:Name="AppOpsTextBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                             FontFamily="Consolas" MinHeight="100"/>
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="dumpsys package">
                <TextBox x:Name="PackageDumpTextBox"
                         IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"/>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Processes">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Click="RefreshProcesses_Click" Content="Refresh processes"/>
            <TextBlock x:Name="ProcessHintText" VerticalAlignment="Center" Foreground="#A2ADA6"/>
          </DockPanel>
          <TextBox Grid.Row="1" x:Name="ProcessTextBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
        </Grid>
      </TabItem>

      <TabItem Header="Logs">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <WrapPanel Margin="0,0,0,8">
              <TextBlock Margin="0,7,6,0" Foreground="#A2ADA6" Text="Filter"/>
              <TextBox x:Name="LogFilterBox" Width="220" Margin="0,0,10,7" ToolTip="Case-insensitive text across the whole log record, including exception lines"/>
              <TextBlock Margin="0,7,6,0" Foreground="#A2ADA6" Text="Minimum level"/>
              <ComboBox x:Name="LogLevelBox" Width="110" SelectedIndex="0" Margin="0,0,10,7">
                <ComboBoxItem Content="All" Tag="*"/>
                <ComboBoxItem Content="Verbose" Tag="V"/>
                <ComboBoxItem Content="Debug" Tag="D"/>
                <ComboBoxItem Content="Info" Tag="I"/>
                <ComboBoxItem Content="Warn" Tag="W"/>
                <ComboBoxItem Content="Error" Tag="E"/>
                <ComboBoxItem Content="Fatal" Tag="F"/>
              </ComboBox>
              <TextBlock Text="Tag" Foreground="#A2ADA6" Margin="0,7,6,0"/>
              <TextBox x:Name="LogTagBox" Width="110" Margin="0,0,8,7" ToolTip="Exact Tag, case-insensitive; combines with text, PID and minimum level"/>
              <TextBlock Text="PID" Foreground="#A2ADA6" Margin="0,7,6,0"/>
              <TextBox x:Name="LogPidBox" Width="76" Margin="0,0,8,7" ToolTip="Optional PID"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
              <CheckBox x:Name="OnlySelectedAppLogBox" Margin="0,0,14,0" Content="Selected app PID only"/>
              <CheckBox x:Name="PauseLogBox" Content="Pause view"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10">
              <Button x:Name="StartLiveLogButton" Click="StartLiveLog_Click" Content="Start live"/>
              <Button x:Name="StopLiveLogButton" IsEnabled="False" Click="StopLiveLog_Click" Content="Stop" Background="#48534D"/>
              <Button x:Name="SnapshotLogButton" Click="SnapshotLog_Click" Content="Snapshot" Background="#48534D"/>
              <Button Click="ImportLog_Click" Content="Import ADB log" Background="#48534D"/>
              <Button Click="ExportLog_Click" Content="Export all retained" Background="#48534D"/>
              <Button Click="ExportFilteredLog_Click" Content="Export filtered" Background="#48534D"/>
              <Button Click="ClearLogView_Click" Content="Clear view" Background="#48534D"/>
            </WrapPanel>
            <TextBlock x:Name="LogCountText" Text="No source loaded. Filter changes apply to retained records." Foreground="#A2ADA6" Margin="0,0,0,8" TextWrapping="Wrap"/>
          </StackPanel>
          <ListBox Grid.Row="1" x:Name="LogLines" Background="#242826" BorderBrush="#404A45" Foreground="#E5E7EB"
                   FontFamily="Consolas" FontSize="12" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItemStyle}"><Setter Property="Padding" Value="3,1"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="NoWrap"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Files">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <WrapPanel>
            <Button x:Name="RemoteBackButton" Content="← Back" Click="RemoteBack_Click" IsEnabled="False"/>
            <Button x:Name="RemoteForwardButton" Content="Forward →" Click="RemoteForward_Click" IsEnabled="False"/>
            <Button Content="Internal storage" Tag="/sdcard" Click="RemoteLocation_Click"/>
            <Button Content="Downloads" Tag="/sdcard/Download" Click="RemoteLocation_Click"/>
            <Button Content="DCIM" Tag="/sdcard/DCIM" Click="RemoteLocation_Click"/>
            <TextBox x:Name="RemoteSearchBox" Width="190" TextChanged="RemoteFilterChanged" ToolTip="Filter this folder by name"/>
            <ComboBox x:Name="RemoteSortBox" SelectedIndex="0" SelectionChanged="RemoteSortChanged" Width="145" Margin="8,0,0,7">
              <ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Name Z–A"/>
              <ComboBoxItem Content="Largest first"/><ComboBoxItem Content="Newest first"/>
            </ComboBox>
          </WrapPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Button x:Name="RemoteRootButton" Click="RemoteRoot_Click" Content="Root" Background="#48534D"/>
              <Button x:Name="RemoteUpButton" Click="RemoteUp_Click" Content="Up" Background="#48534D"/>
            </StackPanel>
            <TextBox Grid.Column="1" x:Name="RemoteFilePathBox" KeyDown="RemotePath_KeyDown" TextChanged="RemotePathChanged" Margin="0,0,7,7" Text="/sdcard/Download"/>
            <Button x:Name="RemoteRefreshButton" Grid.Column="2" Click="RefreshRemoteFiles_Click" Content="Refresh"/>
          </Grid>
          </StackPanel>
          <ListView Grid.Row="1"
                    x:Name="RemoteFileList" SelectionChanged="RemoteSelectionChanged"
                    KeyDown="RemoteFiles_KeyDown" ContextMenuOpening="RemoteContextMenuOpening"
                    SelectionMode="Extended"
                    MouseDoubleClick="RemoteFileList_MouseDoubleClick"
                    Background="#202322"
                    Foreground="#E5E7EB"
                    BorderBrush="#404A45">
            <ListView.Resources>
              <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="#303633"/>
                <Setter Property="Foreground" Value="#E5E7EB"/>
                <Setter Property="BorderBrush" Value="#404A45"/>
                <Setter Property="Padding" Value="8,6"/>
              </Style>
            </ListView.Resources>
            <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="Foreground" Value="#E5E7EB"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,7"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#303633"/></Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#465F52"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#A1BDAA"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Name" Width="420" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding Modified}"/>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <WrapPanel>
              <Button x:Name="RemoteUploadButton" Click="UploadRemoteFile_Click" Content="Upload"/>
              <Button x:Name="RemoteDownloadButton" Click="DownloadRemoteFile_Click" Content="Download" Background="#48534D"/>
              <Button x:Name="RemoteDeleteButton" Click="DeleteRemoteFile_Click" Content="Delete" Background="#76514A"/>
              <Button x:Name="RemoteOpenButton" Click="RemoteOpen_Click" Content="Open folder"/>
            </WrapPanel>
            <TextBlock Text="New / renamed item name" Foreground="#A2ADA6" Margin="0,0,0,5"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="NewFolderNameBox" Grid.Column="0" Margin="0,0,7,7" ToolTip="Name for New folder or Rename selected (F2)"/>
              <Button x:Name="RemoteNewFolderButton" Grid.Column="1" Click="CreateRemoteFolder_Click" Content="New folder" Background="#48534D"/>
              <Button x:Name="RemoteRenameButton" Grid.Column="2" Click="RenameRemoteFile_Click" Content="Rename selected" Background="#48534D" ToolTip="Use the name field to enter a new name"/>
            </Grid>
            <TextBlock x:Name="FileStatusText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Foreground="#A1BDAA" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Shell">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="1" Margin="0,9,0,3" HorizontalAlignment="Left">
            <ComboBox x:Name="SavedCommandsBox" Width="210" Margin="0,0,7,7" SelectionChanged="SavedCommandSelected" ToolTip="Favorite ADB shell commands"/>
            <Button Click="SaveShellFavorite_Click" Content="★ Save" Background="#48534D"/>
            <Button Click="RemoveShellFavorite_Click" Content="Remove" Background="#48534D"/>
          </WrapPanel>
          <TextBox Grid.Row="0" x:Name="ShellOutputBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
          <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ShellCommandBox"
                     KeyDown="ShellCommandBox_KeyDown"
                     Margin="0,0,7,7"
                     FontFamily="Consolas"
                     ToolTip="Enter executes. Up/Down navigate command history."/>
            <Button x:Name="RunShellButton" Grid.Column="1" Click="RunShell_Click" Content="Run"/>
            <Button Grid.Column="2" Click="ClearShell_Click" Content="Clear" Background="#48534D"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Network">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Click="RefreshNetwork_Click" Content="Interfaces / DNS / routes / ports"/>
            <TextBox x:Name="PingHostBox" Width="200" Text="8.8.8.8" Margin="8,0,6,7"/>
            <Button Click="PingHost_Click" Content="Ping" Background="#48534D"/>
          </WrapPanel>
          <TextBox Grid.Row="1" x:Name="NetworkTextBox" IsReadOnly="True"
                   AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>

      <TabItem Header="Device">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#202322" BorderBrush="#303633" BorderThickness="1" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Device"/>
                <TextBlock x:Name="DeviceDetailText" Margin="0,8,0,0" Foreground="#C9D1CC" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Click="RefreshDeviceDetails_Click" Content="Refresh details" VerticalAlignment="Top"/>
            </Grid>
          </Border>
          <TextBox Grid.Row="1" x:Name="DeviceDetailsTextBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
          <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Click="RebootDevice_Click" Content="Reboot device" Background="#76514A"/>
            <Button Click="RestartAdb_Click" Content="Restart ADB server" Background="#76514A"/>
            <Button Click="ExportBugreport_Click" Content="Export bugreport" Background="#48534D"/>
            <TextBlock Margin="10,7,0,0" Foreground="#829088" TextWrapping="Wrap"
                       Text="Restarting ADB affects all connected devices and active mirror sessions."/>
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#202322" BorderBrush="#303633" BorderThickness="0,1,0,0" Padding="12,8">
      <TextBlock x:Name="StatusText" Foreground="#A2ADA6" Text="Ready" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Border>
  </Grid>
</Window>
