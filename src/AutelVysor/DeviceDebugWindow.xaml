<Window x:Class="AutelVysor.DeviceDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autel Vysor · Device Debug"
        Width="1180" Height="780" MinWidth="980" MinHeight="680"
        Background="#0B1120" Foreground="#F1F5F9">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
      <Setter Property="Padding" Value="7"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#334155"/>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItemStyle}">
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItemStyle}">
      <Setter Property="Padding" Value="14,8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="DeviceNameText" FontSize="22" FontWeight="Bold"/>
          <TextBlock x:Name="DeviceMetaText" Margin="0,4,0,0" Foreground="#94A3B8"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Click="RefreshPackages_Click" Content="Refresh packages" Background="#475569"/>
          <Button Click="RefreshAppInfo_Click" Content="Refresh selected app"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="12" Background="#0B1120" BorderBrush="#1E293B">
      <TabItem Header="App">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Apps" Foreground="#94A3B8" Margin="0,7,8,0"/>
                <ComboBox x:Name="AppCategoryBox" Width="120" SelectedIndex="0" SelectionChanged="AppFilterChanged">
                  <ComboBoxItem Content="All"/>
                  <ComboBoxItem Content="User"/>
                  <ComboBoxItem Content="System"/>
                </ComboBox>
                <TextBox x:Name="PackageSearchBox" Width="255" Margin="8,0,0,0"
                         TextChanged="AppFilterChanged" ToolTip="Search installed package names"/>
              </WrapPanel>
              <TextBlock Foreground="#94A3B8" Margin="0,0,0,5" Text="Package name"/>
              <ComboBox x:Name="PackageBox"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        StaysOpenOnEdit="True"
                        MinWidth="520"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
              <Button Click="InstallApk_Click" Content="Install APK" Background="#475569"/>
              <Button Click="UninstallApp_Click" Content="Uninstall" Background="#B45309"/>
            </StackPanel>
          </Grid>

          <WrapPanel Grid.Row="1" Margin="0,12,0,10">
            <Button Click="ForceStopApp_Click" Content="Stop app" Background="#475569"/>
            <Button Click="StartApp_Click" Content="Start app"/>
            <Button Click="RestartApp_Click" Content="Restart app" Background="#475569"/>
            <Button Click="ClearAppData_Click" Content="Clear data" Background="#B45309"/>
            <CheckBox x:Name="KeepDataBox" Margin="8,8,0,0" Content="Keep data when uninstalling"/>
          </WrapPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340"/>
              <ColumnDefinition Width="5"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="App summary"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Version" Foreground="#64748B"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText"/>
                  <TextBlock Grid.Row="1" Text="Version code" Foreground="#64748B"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionCodeText"/>
                  <TextBlock Grid.Row="2" Text="PID" Foreground="#64748B"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PidText"/>
                  <TextBlock Grid.Row="3" Text="Min SDK" Foreground="#64748B"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MinSdkText"/>
                  <TextBlock Grid.Row="4" Text="Target SDK" Foreground="#64748B"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TargetSdkText"/>
                  <TextBlock Grid.Row="5" Text="First install" Foreground="#64748B"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" x:Name="FirstInstallText" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="6" Text="Last update" Foreground="#64748B"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LastUpdateText" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="7" Text="Data dir" Foreground="#64748B"/>
                  <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DataDirText" TextWrapping="Wrap"/>
                </Grid>
              </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#1E293B"/>

            <TabControl Grid.Column="2" Margin="10,0,0,0" Background="#0F172A">
              <TabItem Header="Permissions">
                <TextBox x:Name="PermissionsTextBox"
                         IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"/>
              </TabItem>
              <TabItem Header="Permission manager">
                <Grid Margin="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Runtime permission (pm grant / revoke)" Foreground="#CBD5E1"/>
                  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,9">
                    <TextBox x:Name="PermissionNameBox" Width="290" Text="android.permission.CAMERA"/>
                    <Button Click="GrantPermission_Click" Content="Grant" Margin="8,0,4,0"/>
                    <Button Click="RevokePermission_Click" Content="Revoke" Background="#B45309"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="AppOps (Android enforces support / permissions)" Foreground="#CBD5E1"/>
                  <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <WrapPanel>
                      <TextBox x:Name="AppOpNameBox" Width="140" Text="CAMERA"/>
                      <ComboBox x:Name="AppOpModeBox" Width="120" Margin="8,0,8,0" SelectedIndex="0">
                        <ComboBoxItem Content="allow"/>
                        <ComboBoxItem Content="ignore"/>
                        <ComboBoxItem Content="deny"/>
                        <ComboBoxItem Content="default"/>
                      </ComboBox>
                      <Button Click="SetAppOp_Click" Content="Set AppOp"/>
                      <Button Click="RefreshAppOps_Click" Content="Read AppOps" Background="#475569"/>
                    </WrapPanel>
                    <TextBox x:Name="AppOpsTextBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                             FontFamily="Consolas" MinHeight="100"/>
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="dumpsys package">
                <TextBox x:Name="PackageDumpTextBox"
                         IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"/>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Processes">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Click="RefreshProcesses_Click" Content="Refresh processes"/>
            <TextBlock x:Name="ProcessHintText" VerticalAlignment="Center" Foreground="#94A3B8"/>
          </DockPanel>
          <TextBox Grid.Row="1" x:Name="ProcessTextBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
        </Grid>
      </TabItem>

      <TabItem Header="Logs">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <WrapPanel Margin="0,0,0,8">
              <TextBlock Margin="0,7,6,0" Foreground="#94A3B8" Text="Filter"/>
              <TextBox x:Name="LogFilterBox" Width="220" Margin="0,0,10,7" ToolTip="Text, tag or message contains"/>
              <TextBlock Margin="0,7,6,0" Foreground="#94A3B8" Text="Minimum level"/>
              <ComboBox x:Name="LogLevelBox" Width="110" SelectedIndex="0" Margin="0,0,10,7">
                <ComboBoxItem Content="All" Tag="*"/>
                <ComboBoxItem Content="Verbose" Tag="V"/>
                <ComboBoxItem Content="Debug" Tag="D"/>
                <ComboBoxItem Content="Info" Tag="I"/>
                <ComboBoxItem Content="Warn" Tag="W"/>
                <ComboBoxItem Content="Error" Tag="E"/>
                <ComboBoxItem Content="Fatal" Tag="F"/>
              </ComboBox>
              <TextBlock Text="Tag" Foreground="#94A3B8" Margin="0,7,6,0"/>
              <TextBox x:Name="LogTagBox" Width="110" Margin="0,0,8,7" ToolTip="Exact Android logcat Tag substring"/>
              <TextBlock Text="PID" Foreground="#94A3B8" Margin="0,7,6,0"/>
              <TextBox x:Name="LogPidBox" Width="76" Margin="0,0,8,7" ToolTip="Optional PID"/>
              <CheckBox x:Name="OnlySelectedAppLogBox" Margin="0,7,14,7" Content="Selected app PID only"/>
              <CheckBox x:Name="PauseLogBox" Margin="0,7,0,7" Content="Pause"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10">
              <Button Click="StartLiveLog_Click" Content="Start live"/>
              <Button Click="StopLiveLog_Click" Content="Stop" Background="#475569"/>
              <Button Click="SnapshotLog_Click" Content="Snapshot" Background="#475569"/>
              <Button Click="ExportLog_Click" Content="Export logcat" Background="#475569"/>
              <Button Click="ClearLogView_Click" Content="Clear view" Background="#475569"/>
            </WrapPanel>
          </StackPanel>
          <TextBox Grid.Row="1" x:Name="LogTextBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="11"/>
        </Grid>
      </TabItem>

      <TabItem Header="Files">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="RemoteUp_Click" Content="Up" Background="#475569"/>
            <TextBox Grid.Column="1" x:Name="RemoteFilePathBox" Margin="0,0,7,7" Text="/sdcard/Download"/>
            <Button Grid.Column="2" Click="RefreshRemoteFiles_Click" Content="Refresh"/>
          </Grid>
          <ListView Grid.Row="1"
                    x:Name="RemoteFileList"
                    SelectionMode="Extended"
                    MouseDoubleClick="RemoteFileList_MouseDoubleClick"
                    Background="#0F172A"
                    Foreground="#E5E7EB"
                    BorderBrush="#334155">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Name" Width="420" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding Modified}"/>
              </GridView>
            </ListView.View>
          </ListView>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="UploadRemoteFile_Click" Content="Upload"/>
            <Button Grid.Column="1" Click="DownloadRemoteFile_Click" Content="Download" Background="#475569"/>
            <Button Grid.Column="2" Click="DeleteRemoteFile_Click" Content="Delete" Background="#B45309"/>
            <TextBox Grid.Column="3" x:Name="NewFolderNameBox" Margin="6,0,7,7" ToolTip="New folder name"/>
            <Button Grid.Column="4" Click="CreateRemoteFolder_Click" Content="New folder" Background="#475569"/>
            <TextBlock Grid.Column="5" Margin="10,7,0,0" Foreground="#64748B" Text="Double-click a folder to open it."/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Shell">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="1" Margin="0,9,0,3" HorizontalAlignment="Left">
            <ComboBox x:Name="SavedCommandsBox" Width="210" SelectionChanged="SavedCommandSelected" ToolTip="Favorite ADB shell commands"/>
            <Button Click="SaveShellFavorite_Click" Content="★ Save" Background="#475569"/>
            <Button Click="RemoveShellFavorite_Click" Content="Remove" Background="#475569"/>
          </WrapPanel>
          <TextBox Grid.Row="0" x:Name="ShellOutputBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
          <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ShellCommandBox"
                     KeyDown="ShellCommandBox_KeyDown"
                     FontFamily="Consolas"
                     ToolTip="Enter executes. Up/Down navigate command history."/>
            <Button Grid.Column="1" Click="RunShell_Click" Content="Run"/>
            <Button Grid.Column="2" Click="ClearShell_Click" Content="Clear" Background="#475569"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Network">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Click="RefreshNetwork_Click" Content="Interfaces / DNS / routes / ports"/>
            <TextBox x:Name="PingHostBox" Width="200" Text="8.8.8.8" Margin="8,0,6,7"/>
            <Button Click="PingHost_Click" Content="Ping" Background="#475569"/>
          </WrapPanel>
          <TextBox Grid.Row="1" x:Name="NetworkTextBox" IsReadOnly="True"
                   AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>

      <TabItem Header="Device">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Device"/>
                <TextBlock x:Name="DeviceDetailText" Margin="0,8,0,0" Foreground="#CBD5E1" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1" Click="RefreshDeviceDetails_Click" Content="Refresh details" VerticalAlignment="Top"/>
            </Grid>
          </Border>
          <TextBox Grid.Row="1" x:Name="DeviceDetailsTextBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
          <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Click="RebootDevice_Click" Content="Reboot device" Background="#B45309"/>
            <Button Click="RestartAdb_Click" Content="Restart ADB server" Background="#B45309"/>
            <Button Click="ExportBugreport_Click" Content="Export bugreport" Background="#475569"/>
            <TextBlock Margin="10,7,0,0" Foreground="#64748B" TextWrapping="Wrap"
                       Text="Restarting ADB affects all connected devices and active mirror sessions."/>
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,8">
      <TextBlock x:Name="StatusText" Foreground="#94A3B8" Text="Ready"/>
    </Border>
  </Grid>
</Window>
