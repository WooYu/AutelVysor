<Window x:Class="AutelVysor.DeviceDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autel Vysor · Device Debug"
        Width="1180" Height="780" MinWidth="980" MinHeight="680"
        Background="#0B1120" Foreground="#F1F5F9">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,0,7,7"/>
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
      <Setter Property="BorderBrush" Value="#334155"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="7"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#334155"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="14,8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="DeviceNameText" FontSize="22" FontWeight="Bold"/>
          <TextBlock x:Name="DeviceMetaText" Margin="0,4,0,0" Foreground="#94A3B8"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Click="RefreshPackages_Click" Content="Refresh packages" Background="#475569"/>
          <Button Click="RefreshAppInfo_Click" Content="Refresh selected app"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="12" Background="#0B1120" BorderBrush="#1E293B">
      <TabItem Header="App">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Margin="0,0,0,5" Text="Package name"/>
              <ComboBox x:Name="PackageBox"
                        IsEditable="True"
                        IsTextSearchEnabled="True"
                        StaysOpenOnEdit="True"
                        MinWidth="520"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
              <Button Click="InstallApk_Click" Content="Install APK" Background="#475569"/>
              <Button Click="UninstallApp_Click" Content="Uninstall" Background="#B45309"/>
            </StackPanel>
          </Grid>

          <WrapPanel Grid.Row="1" Margin="0,12,0,10">
            <Button Click="ForceStopApp_Click" Content="Stop app" Background="#475569"/>
            <Button Click="StartApp_Click" Content="Start app"/>
            <Button Click="RestartApp_Click" Content="Restart app" Background="#475569"/>
            <Button Click="ClearAppData_Click" Content="Clear data" Background="#B45309"/>
            <CheckBox x:Name="KeepDataBox" Margin="8,8,0,0" Content="Keep data when uninstalling"/>
          </WrapPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340"/>
              <ColumnDefinition Width="5"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="App summary"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Version" Foreground="#64748B"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText"/>
                  <TextBlock Grid.Row="1" Text="Version code" Foreground="#64748B"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionCodeText"/>
                  <TextBlock Grid.Row="2" Text="PID" Foreground="#64748B"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PidText"/>
                  <TextBlock Grid.Row="3" Text="Min SDK" Foreground="#64748B"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MinSdkText"/>
                  <TextBlock Grid.Row="4" Text="Target SDK" Foreground="#64748B"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TargetSdkText"/>
                  <TextBlock Grid.Row="5" Text="First install" Foreground="#64748B"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" x:Name="FirstInstallText" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="6" Text="Last update" Foreground="#64748B"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LastUpdateText" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="7" Text="Data dir" Foreground="#64748B"/>
                  <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DataDirText" TextWrapping="Wrap"/>
                </Grid>
              </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#1E293B"/>

            <TabControl Grid.Column="2" Margin="10,0,0,0" Background="#0F172A">
              <TabItem Header="Permissions">
                <TextBox x:Name="PermissionsTextBox"
                         IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"/>
              </TabItem>
              <TabItem Header="dumpsys package">
                <TextBox x:Name="PackageDumpTextBox"
                         IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12"/>
              </TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Processes">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Click="RefreshProcesses_Click" Content="Refresh processes"/>
            <TextBlock x:Name="ProcessHintText" VerticalAlignment="Center" Foreground="#94A3B8"/>
          </DockPanel>
          <TextBox Grid.Row="1" x:Name="ProcessTextBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12"/>
        </Grid>
      </TabItem>

      <TabItem Header="Logs">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Click="StartLiveLog_Click" Content="Start live"/>
            <Button Click="StopLiveLog_Click" Content="Stop" Background="#475569"/>
            <Button Click="SnapshotLog_Click" Content="Snapshot" Background="#475569"/>
            <Button Click="ExportLog_Click" Content="Export logcat" Background="#475569"/>
            <Button Click="ClearLogView_Click" Content="Clear view" Background="#475569"/>
          </WrapPanel>
          <TextBox Grid.Row="1" x:Name="LogTextBox"
                   IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="11"/>
        </Grid>
      </TabItem>

      <TabItem Header="Device">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" Padding="14">
            <StackPanel>
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="Device"/>
              <TextBlock x:Name="DeviceDetailText" Margin="0,8,0,0" Foreground="#CBD5E1" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <WrapPanel Grid.Row="1" Margin="0,14,0,0">
            <Button Click="RebootDevice_Click" Content="Reboot device" Background="#B45309"/>
            <Button Click="RestartAdb_Click" Content="Restart ADB server" Background="#B45309"/>
          </WrapPanel>
          <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap"
                     Text="Restarting ADB affects all connected Android devices and may temporarily interrupt every active mirror session. The main window monitor will reconnect when ADB becomes available again."/>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,8">
      <TextBlock x:Name="StatusText" Foreground="#94A3B8" Text="Ready"/>
    </Border>
  </Grid>
</Window>
