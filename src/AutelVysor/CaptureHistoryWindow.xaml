<Window x:Class="AutelVysor.CaptureHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/AutelVysor;component/Assets/AutelVysor.ico"
        Title="Autel Vysor · Captures" Width="950" Height="650" MinWidth="720" MinHeight="480"
        Background="#1B1E1C" Foreground="#F1F5F9">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,7"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#404A45"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
      <Button Click="Refresh_Click" Content="Refresh captures"/>
      <Button x:Name="OpenButton" IsEnabled="False" Click="Open_Click" Content="Open selected"/>
      <Button x:Name="FolderButton" IsEnabled="False" Click="ShowFolder_Click" Content="Show in Explorer"/>
      <Button x:Name="DeleteButton" IsEnabled="False" Click="Delete_Click" Content="Delete selected" Background="#76514A"/>
    </WrapPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" MinWidth="220"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="260"/>
      </Grid.ColumnDefinitions>
      <ListBox x:Name="CaptureList" SelectionChanged="CaptureSelected" Background="#242826"
               Foreground="#E5E7EB" BorderBrush="#404A45" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListItemStyle}">
            <Setter Property="Padding" Value="10,9"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel ToolTip="{Binding Path}">
              <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Details}" Foreground="#C9D1CC" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Width="5" Background="#303633"/>
      <Grid Grid.Column="2" Margin="8,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="Black">
          <Grid>
            <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </ScrollViewer>
            <ContentControl x:Name="VideoHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <TextBlock x:Name="PreviewHint" Text="Select a screenshot or recording to preview."
                       Foreground="#C9D1CC" Margin="20" MaxWidth="520" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
          </Grid>
        </Border>
        <Slider Grid.Row="1" x:Name="SeekSlider" Visibility="Collapsed" Minimum="0" Maximum="1" IsEnabled="False"
                Margin="0,10,0,8" ValueChanged="SeekChanged" ToolTip="Seek recording"/>
        <WrapPanel Grid.Row="2" x:Name="VideoControls" Visibility="Collapsed">
          <Button x:Name="PlayButton" Content="Play" Click="Play_Click" IsEnabled="False"/>
          <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" IsEnabled="False"/>
          <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"/>
          <TextBlock x:Name="PlaybackTime" Foreground="#C9D1CC" VerticalAlignment="Center" Margin="0,0,0,7" Text="00:00 / --:--"/>
        </WrapPanel>
        <WrapPanel Grid.Row="2" x:Name="ImageControls" Visibility="Collapsed">
          <Button Content="Fit image" Click="FitImage_Click"/>
          <Button Content="Actual size" Click="ActualImage_Click"/>
          <TextBlock x:Name="ImageDetails" Foreground="#C9D1CC" VerticalAlignment="Center" Margin="0,0,0,7"/>
        </WrapPanel>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0"
               TextWrapping="Wrap" MaxHeight="65" TextTrimming="CharacterEllipsis" Foreground="#A2ADA6" Text="Screenshots are saved in Pictures; recordings are saved in Videos."/>
  </Grid>
</Window>
