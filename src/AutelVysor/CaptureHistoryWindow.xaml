<Window x:Class="AutelVysor.CaptureHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autel Vysor · Captures" Width="950" Height="650" MinWidth="720" MinHeight="480"
        Background="#0B1120" Foreground="#F1F5F9">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,7"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#334155"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
      <Button Click="Refresh_Click" Content="Refresh captures"/>
      <Button Click="Open_Click" Content="Open selected"/>
      <Button Click="ShowFolder_Click" Content="Show in Explorer"/>
      <Button Click="Delete_Click" Content="Delete selected" Background="#B45309"/>
    </WrapPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ListBox x:Name="CaptureList" SelectionChanged="CaptureSelected" Background="#111827"
               Foreground="#E5E7EB" BorderBrush="#334155"
               DisplayMemberPath="Display"/>
      <GridSplitter Grid.Column="1" Width="5" Background="#1E293B"/>
      <Border Grid.Column="2" Background="Black" Margin="8,0,0,0">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform"/>
          <TextBlock x:Name="PreviewHint" Text="Select an image to preview, or open a recording."
                     Foreground="#94A3B8" VerticalAlignment="Center"
                     HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,10,0,0"
               Foreground="#94A3B8" Text="Screenshots are saved in Pictures; recordings are saved in Videos."/>
  </Grid>
</Window>