<UserControl x:Class="AutelVysor.Controls.MirrorSessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AutelVysor.Controls"
             Background="#171A19"
             Foreground="#E5E7EB"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown"
             PreviewTextInput="Root_PreviewTextInput">
  <UserControl.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Background" Value="#303633"/>
      <Setter Property="Foreground" Value="#E4E9E5"/>
      <Setter Property="BorderBrush" Value="#374151"/>
    </Style>
    <Style x:Key="SessionIconButton" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="SessionLayout">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="InlineToolsColumn" Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="SessionTools" Grid.Column="0" Background="#242826" BorderBrush="#404A45" BorderThickness="0,0,0,1" Padding="10" TextElement.FontSize="13" TextElement.Foreground="#E5E7EB">
      <Border.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
          <Setter Property="Padding" Value="7,7"/><Setter Property="Margin" Value="2,3"/>
        </Style>
      </Border.Resources>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="DeviceTitleText" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="DeviceMetaText" Margin="0,4,0,10" Foreground="#9AA5A0" FontSize="11" TextWrapping="Wrap"/>
          <UniformGrid Columns="6" Margin="0,0,0,8">
            <Button Style="{StaticResource SessionIconButton}" Click="Back_Click" Content="&#xE72B;" ToolTip="Back" AutomationProperties.Name="Back"/>
            <Button Style="{StaticResource SessionIconButton}" Click="Home_Click" Content="&#xE80F;" ToolTip="Home" AutomationProperties.Name="Home"/>
            <Button Style="{StaticResource SessionIconButton}" Click="Recents_Click" Content="&#xE8A7;" ToolTip="Recent apps" AutomationProperties.Name="Recent apps"/>
            <Button Style="{StaticResource SessionIconButton}" Click="VolumeDown_Click" Content="&#xE993;" ToolTip="Volume down" AutomationProperties.Name="Volume down"/>
            <Button Style="{StaticResource SessionIconButton}" Click="VolumeUp_Click" Content="&#xE995;" ToolTip="Volume up" AutomationProperties.Name="Volume up"/>
            <Button Style="{StaticResource SessionIconButton}" Click="Power_Click" Content="&#xE7E8;" ToolTip="Power" AutomationProperties.Name="Power"/>
          </UniformGrid>
          <TextBlock Text="电脑输入法 / PC text" FontWeight="SemiBold" Margin="2,8,0,5"/>
          <TextBox x:Name="AndroidTextBox" Background="#1C201E" Foreground="#E5E7EB" BorderBrush="#404A45" CaretBrush="White"
                   MinHeight="32" Padding="6,5" PreviewKeyDown="AndroidTextBox_PreviewKeyDown" ToolTip="Use the computer input method here. Press Enter to send to the selected phone field."/>
          <UniformGrid Columns="2">
            <Button x:Name="SendTextButton" Click="SendText_Click" Content="Paste text" ToolTip="Paste into the focused Android field; updates the PC clipboard."/>
            <Button x:Name="FocusKeyboardButton" Focusable="False" Click="FocusMirror_Click" Content="Focus keyboard" ToolTip="Keyboard focus is automatic when the mirror opens. Click to restore it after using PC tools."/>
          </UniformGrid>
          <CheckBox x:Name="PhoneKeyboardToggle" IsEnabled="False" Checked="PhoneKeyboardToggle_Changed" Unchecked="PhoneKeyboardToggle_Changed" Margin="2,8,2,5"
                    Content="连接电脑键盘时隐藏手机软键盘" Foreground="#D4DAD6"/>
          <TextBlock x:Name="ImeRecoveryText" Visibility="Collapsed" Margin="0,6,0,0" Foreground="#FBBF24" TextWrapping="Wrap"
                     Text="Saved IME recovery exists. Open Input options → ADB IME setup and choose Restore original keyboard."/>
          <Expander Header="输入与显示设置" Margin="2,8,2,4" Foreground="#B8C0BB">
            <StackPanel>
          <ComboBox x:Name="KeyboardModeBox" SelectedIndex="0" Margin="2,4" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="KeyboardModeChanged"
                    ToolTip="Auto uses hardware keyboard on Android 9+. Compatible uses SDK events; changing mode restarts this mirror.">
            <ComboBoxItem Content="Keyboard: Auto" Tag="auto"/><ComboBoxItem Content="Hardware" Tag="uhid"/><ComboBoxItem Content="Compatible" Tag="sdk"/>
          </ComboBox>
        <Button Click="InputOptions_Click" Content="Input options">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy text only" Click="CopyAndroidText_Click"/>
              <MenuItem Header="Phone hardware keyboard settings" Click="PhoneKeyboardSettings_Click"/>
              <Separator/>
              <MenuItem Header="ADB IME setup (optional)" Click="UnicodeSetup_Click"/>
              <MenuItem Header="Send via ADB IME (optional)" Click="SendUnicode_Click"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

          <TextBlock x:Name="InputHint" Margin="2,5,2,8" FontSize="11" Foreground="#A2ADA6" TextWrapping="Wrap"
                     Text="先点手机输入框，再在这里输入；按 Enter 发送。"/>
          <UniformGrid Columns="2">
            <Button x:Name="RotateButton" Click="Rotate_Click" Content="Switch orientation" ToolTip="Switch the real Android display between its two main orientations"/>
            <Button x:Name="AutoRotateButton" Click="AutoRotate_Click" Content="Auto rotate"/>
          </UniformGrid>
          <TextBlock x:Name="RotateStateText" Foreground="#C9D1CC" TextWrapping="Wrap" Margin="2,4,2,8"/>
          <UniformGrid Columns="2">
            <Button x:Name="AudioRoutesButton" Click="AudioRoute_Click" Content="Audio routes"/>
            <Button Click="Restart_Click" Content="Restart"/>
          </UniformGrid>
          <Expander Header="Advanced zoom · crops image" Margin="2,8,2,4" Foreground="#A2ADA6">
            <StackPanel Margin="0,5,0,0">
              <TextBlock Text="Optional: use Fit above to show the entire frame." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5"/>
              <ComboBox x:Name="ZoomBox" SelectedIndex="0" SelectionChanged="ZoomChanged" Style="{StaticResource DarkComboBoxStyle}">
                <ComboBoxItem Content="Fit · 100%" Tag="1"/><ComboBoxItem Content="125%" Tag="1.25"/><ComboBoxItem Content="150%" Tag="1.5"/>
                <ComboBoxItem Content="200%" Tag="2"/><ComboBoxItem Content="300%" Tag="3"/><ComboBoxItem Content="1:1" Tag="actual"/>
              </ComboBox>
              <Button Click="ActualSize_Click" Content="1:1 · actual pixels"/>
            </StackPanel>
          </Expander>
            </StackPanel>
          </Expander>
          <TextBlock x:Name="StatusText" Foreground="#C9D1CC" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxHeight="20" ClipToBounds="True"
                     Margin="2,8,2,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="AudioRouteText" Foreground="#A1BDAA" TextWrapping="Wrap" FontSize="11" Margin="2,3"/>
          <TextBlock x:Name="BackendText" Foreground="#829088" FontSize="11" Margin="2,3"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid x:Name="MirrorViewport" Grid.Column="1" Background="Black" ClipToBounds="True" SizeChanged="Viewport_SizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <controls:NativeWindowHost x:Name="ScrcpyHost" Visibility="Collapsed"/>

      <Grid x:Name="LegacyHost" Visibility="Collapsed" Background="Black" AllowDrop="True" ClipToBounds="True"
            DragOver="LegacyHost_DragOver" Drop="LegacyHost_Drop">
        <Image x:Name="LegacyImage"
               Stretch="Uniform"
               MouseLeftButtonDown="LegacyImage_MouseLeftButtonDown"
               MouseLeftButtonUp="LegacyImage_MouseLeftButtonUp"
               MouseRightButtonDown="LegacyImage_MouseRightButtonDown"/>
      </Grid>

      <Border x:Name="Overlay" Background="#CC1C201E">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
          <TextBlock x:Name="OverlayTitle" Text="Starting mirror…" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="OverlayDetail" Margin="0,8,0,0" Foreground="#C9D1CC" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <ScrollBar x:Name="PanVertical" Grid.Column="1" Width="16" Orientation="Vertical" Visibility="Collapsed"
                 Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" LargeChange="0.25" ViewportSize="0.5"
                 ValueChanged="PanChanged" ToolTip="Move the enlarged picture up/down"/>
      <ScrollBar x:Name="PanHorizontal" Grid.Row="1" Height="16" Orientation="Horizontal" Visibility="Collapsed"
                 Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" LargeChange="0.25" ViewportSize="0.5"
                 ValueChanged="PanChanged" ToolTip="Move the enlarged picture left/right"/>
    </Grid>

  </Grid>
</UserControl>
